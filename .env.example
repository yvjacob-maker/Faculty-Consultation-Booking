# CCS Consultation System environment configuration
# Copy this file to .env and replace the placeholder values.
# Never commit .env or real SMTP credentials.

# Web server
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
# Required: 32+ random characters. Replace the placeholder or the server will not start.
SESSION_SECRET=replace-with-a-long-random-string

# Optional SQLite path override (defaults to data/ccs-consultation.sqlite)
# DB_PATH=C:\path\to\ccs-consultation.sqlite

# SMTP email delivery
# Gmail example: smtp.gmail.com, port 587, SMTP_SECURE=false,
# SMTP_REQUIRE_TLS=true. Use a Google App Password, not the normal account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CCS Consultation <no-reply@my.cspc.edu.ph>"
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Temporary passwords are emailed and must be changed at first sign-in.
# SETUP_TOKEN_TTL_HOURS only affects legacy setup links from earlier versions.
SETUP_TOKEN_TTL_HOURS=48
EMAIL_QUEUE_CONCURRENCY=3

# Optional comma-separated approved email domains. Leave blank to allow any
# syntactically valid email address. Subdomains of an allowed domain also pass.
ALLOWED_EMAIL_DOMAINS=my.cspc.edu.ph
